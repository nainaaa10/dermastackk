# Dermastack Backend Configuration

# Application Mode: 'development', 'staging', or 'production'
APP_ENV=development

# Force Demo Mode (true/false). When true, returns structured demo outputs without requiring weights.
DEMO_MODE=true

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dermastack

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=15728640

# Machine Learning Checkpoint Path
MODEL_WEIGHTS_PATH=ml/weights/best_hybrid_skin_model.pt
MODEL_VERSION=v1.0.0-experimental

# Privacy & Image Retention (Strictly False by default)
ALLOW_IMAGE_PERSISTENCE=false
